# Copy to `.env` (gitignored) for local builds. In CI these come from
# GitHub Actions variables with the same names.

# Reown Cloud project id for WalletConnect (EVM/TRON dApp connections).
# Get one at https://cloud.reown.com. Builds without it disable
# WalletConnect pairing (relay init fails).
WALLETCONNECT_PROJECT_ID=

# The two origins the domain migration runs between. `apps/web` is served on
# the new one, `apps/migration` on the old one. Locally two ports are already
# two origins, which is what gives them separate localStorage.
MIGRATION_OLD_ORIGIN=http://localhost:5174
MIGRATION_NEW_ORIGIN=http://localhost:5173
