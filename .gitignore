.yarn/install-state.gz
.history

.env
.env.local
.env.development.local
.env.test.local
.env.production.local

**/public/locales/*
**/src/wallet-translation/*


package-lock.json

# Local-only reference checkouts of the native apps; scanned when
# multichain features need a behaviour reference. Never committed.
CLAUDE_LOCAL.md

# Ad-hoc screenshots / verification artifacts dropped at the repo root by
# Playwright MCP and similar tools. Tracked PNG assets live in app/package
# folders (apps/*/public, apps/mobile/fastlane/...) and are unaffected by
# the root-only `/*.png`. Console logs and page snapshots land in
# `.playwright-mcp/`.
/*.png
.playwright-mcp/

# Playwright run artifacts. These belong under packages/uikit (already ignored
# there); guard the repo root too so a stray run — or an accidental click on a
# relative artifact path from a terminal at the repo root — is never committed.
/test-results/
/playwright-report/
/blob-report/
