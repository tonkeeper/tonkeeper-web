{
    "name": "@tonkeeper/uikit",
    "version": "0.1.0",
    "author": "Ton APPS UK Limited <support@tonkeeper.com>",
    "description": "UI Kit for tonkeeper wallet",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "storybook": "start-storybook -p 6006",
        "build-storybook": "build-storybook",
        "build": "rm -fr dist tsconfig.build.tsbuildinfo && tsc -p tsconfig.build.json && mkdir -p dist/components/staking dist/components/modals dist/styles/fonts && cp -R src/components/staking/assets dist/components/staking/ && cp -R src/components/modals/assets dist/components/modals/ && cp src/styles/tailwind.css dist/styles/tailwind.css && cp src/styles/fonts/*.woff2 dist/styles/fonts/",
        "dev": "tsc -w -p tsconfig.build.json",
        "start": "tsc -w",
        "build:pkg": "yarn build",
        "typecheck": "tsc --noEmit",
        "icons": "svgr --config-file .svgrrc.cjs --out-dir src/icons/components -- src/icons/svg",
        "test:ct": "node ../../scripts/test-changed-components.mjs --all",
        "test:ct:update": "node ../../scripts/test-changed-components.mjs --all -- --update-snapshots",
        "test:ct:changed": "node ../../scripts/test-changed-components.mjs",
        "test:ct:docker": "sh \"$(git rev-parse --show-toplevel)/packages/uikit/scripts/run-ct-docker.sh\" run",
        "test:ct:update:docker": "sh \"$(git rev-parse --show-toplevel)/packages/uikit/scripts/run-ct-docker.sh\" update",
        "test:ct:update:all:docker": "sh \"$(git rev-parse --show-toplevel)/packages/uikit/scripts/run-ct-docker.sh\" update-all"
    },
    "license": "ISC",
    "dependencies": {
        "@aptabase/web": "^0.5.0",
        "@ark-ui/react": "^5.9.1",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@ionic/core": "patch:@ionic/core@npm%3A8.4.2#~/.yarn/patches/@ionic-core-npm-8.4.2-7a066c6bc2.patch",
        "@ionic/react": "^8.4.2",
        "@ionic/react-hooks": "^0.0.8",
        "@keystonehq/keystone-sdk": "0.7.2",
        "@ngraveio/bc-ur": "^1.1.13",
        "@reown/walletkit": "^1.5.6",
        "@tanstack/react-query": "4.3.4",
        "@tanstack/react-virtual": "^3.8.3",
        "@ton-keychain/core": "^0.0.4",
        "@ton-keychain/trx": "^0.0.7",
        "@ton/core": "0.63.1",
        "@ton/crypto": "3.2.0",
        "@tonkeeper/core": "0.1.0",
        "@zxing/browser": "^0.1.5",
        "@zxing/library": "^0.21.3",
        "bignumber.js": "^9.1.1",
        "dayjs": "^1.11.10",
        "ethers": "^6.13.4",
        "framer-motion": "^11.3.28",
        "i18next": "^23.7.7",
        "lottie-react": "^2.4.1",
        "qrcode-generator": "^1.4.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-hook-form": "^7.51.2",
        "react-i18next": "^13.5.0",
        "react-qrcode-logo": "^2.9.0",
        "react-router-dom": "^5.3.4",
        "react-transition-group": "^4.4.5",
        "recharts": "^2.12.3",
        "styled-components": "^6.1.1",
        "tronweb": "^6.0.0",
        "tweetnacl": "^1.0.3",
        "uuid": "^11.1.1"
    },
    "devDependencies": {
        "@playwright/experimental-ct-react": "1.62.1",
        "@svgr/cli": "^8",
        "@types/react": "^18.0.26",
        "@types/react-dom": "^18.0.9",
        "@types/react-router-dom": "^5.3.3",
        "@types/react-transition-group": "^4.4.5",
        "@types/styled-components": "^5.1.34",
        "@types/uuid": "^9.0.1",
        "@walletconnect/types": "^2.23.10",
        "autoprefixer": "^10.4.20",
        "postcss": "^8.4.49",
        "svgo": "^3",
        "tailwindcss": "^3.4.17",
        "typescript": "^4.9.4",
        "vite": "^8.1.0",
        "vite-plugin-node-polyfills": "0.17.0"
    },
    "packageManager": "yarn@4.3.0"
}
