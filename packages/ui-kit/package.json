{
    "name": "@tonkeeper/ui-kit",
    "version": "0.1.0-alpha.0",
    "description": "Keeper design system: React components, colour themes, icons and Tailwind tokens",
    "author": "Ton APPS UK Limited <support@tonkeeper.com>",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tonkeeper/tonkeeper-web.git",
        "directory": "packages/ui-kit"
    },
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./icons": {
            "types": "./dist/icons/components/index.d.ts",
            "import": "./dist/icons/components/index.js",
            "default": "./dist/icons/components/index.js"
        },
        "./icons/*": {
            "types": "./dist/icons/components/*.d.ts",
            "import": "./dist/icons/components/*.js",
            "default": "./dist/icons/components/*.js"
        },
        "./tailwind-preset": {
            "types": "./dist/tailwind/preset.d.ts",
            "import": "./dist/tailwind/preset.js",
            "default": "./dist/tailwind/preset.js"
        },
        "./styles.css": "./dist/styles.css",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "rm -rf dist && vite build && tsc -p tsconfig.build.json && tailwindcss -c tailwind.config.ts -i src/styles/styles.css -o dist/styles.css --minify && cp -R src/styles/fonts dist/fonts",
        "typecheck": "tsc --noEmit",
        "icons": "svgr --config-file .svgrrc.cjs --out-dir src/icons/components -- src/icons/svg",
        "test:ct": "playwright test -c playwright-ct.config.ts",
        "test:ct:update": "playwright test -c playwright-ct.config.ts --update-snapshots"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18",
        "tailwindcss": "^3.4"
    },
    "peerDependenciesMeta": {
        "tailwindcss": {
            "optional": true
        }
    },
    "devDependencies": {
        "@playwright/experimental-ct-react": "1.62.1",
        "@svgr/cli": "^8",
        "@types/react": "^18.0.26",
        "@types/react-dom": "^18.0.9",
        "autoprefixer": "^10.4.20",
        "postcss": "^8.4.49",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "svgo": "^3",
        "tailwindcss": "^3.4.17",
        "typescript": "5.2.2",
        "vite": "^8.1.0"
    }
}
