{
    "name": "tonkeeper-web",
    "version": "0.0.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/tonkeeper/tonkeeper-web.git"
    },
    "scripts": {
        "dev:web": "npx turbo build:pkg --filter=@tonkeeper/core --filter=@tonkeeper/locales --filter=@tonkeeper/uikit && npx turbo dev --filter=@tonkeeper/web --filter=@tonkeeper/uikit --filter=@tonkeeper/core --filter=@tonkeeper/locales --parallel",
        "build": "npx turbo build",
        "dev:migration": "npx turbo dev --filter=@tonkeeper/migration",
        "build:web": "npx turbo build:web",
        "build:migration": "npx turbo build:migration",
        "dev:showcase": "yarn workspace @tonkeeper/ui-showcase dev",
        "build:showcase": "npx turbo build:showcase",
        "build:ui-kit": "yarn workspace @tonkeeper/ui-kit build",
        "build:twa": "npx turbo build:twa",
        "deploy:twa": "npx turbo build:twa && npx wrangler pages deploy apps/twa/build",
        "build:extension": "npx turbo build:extension",
        "build:desktop": "npx turbo build:desktop",
        "build:ipad": "npx turbo build:ipad",
        "build:pkg": "npx turbo build:pkg",
        "lint": "eslint --ext .ts,.tsx .",
        "lint:fix": "eslint --ext .ts,.tsx . --fix",
        "lint:css": "stylelint \"{apps,packages}/**/src/**/*.{ts,tsx,css}\"",
        "lint:css:fix": "stylelint \"{apps,packages}/**/src/**/*.{ts,tsx,css}\" --fix",
        "lint:i18n": "yarn workspace @tonkeeper/locales lint:i18n",
        "typecheck": "npx turbo typecheck",
        "test": "npx turbo test --filter='!@tonkeeper/playwrite'",
        "prepare": "husky",
        "prepare-release": "node scripts/prepare-release.js"
    },
    "private": true,
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^5.50.0",
