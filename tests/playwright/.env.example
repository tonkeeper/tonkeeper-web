BASE_APP_URL='https://wallet.tonkeeper.com'
TRANSACTION_TESTS=true
TON_MNEMONIC_24=''
TON_MNEMONIC_24_2=''
TON_MNEMONIC_24_3=''
TON_MNEMONIC_24_4=''
TON_MNEMONIC_24_5=''
TON_MNEMONIC_ANANAS=''
TON_MNEMONIC_12=''
TON_MNEMONIC_12_2=''
FAKE_MNEMONIC=''

# QA wallets for `yarn workspace @tonkeeper/playwrite qa`.
# Copy to tests/playwright/.env (gitignored) and fill in yourself. Agents are blocked from reading
# the real file (.claude/hooks/guard-secrets.mjs); the test process loads it through dotenv.
# Both wallets hold real money: keep only the monthly top-up on them.

# Wallet A: BIP39 phrase that is NOT a valid TON phrase, imports as a multichain account.
QA_WALLET_A_MNEMONIC=
QA_WALLET_A_TON_ADDRESS=
# Wallet B: 24-word TON phrase, imports as a legacy TON account.
QA_WALLET_B_MNEMONIC=
QA_WALLET_B_TON_ADDRESS=
# Wallet C (optional): its battery must stay EMPTY forever. Never charge it, never gift it a charge.
# Any phrase type: it imports as multichain or legacy TON by its shape. Fund it only with what the
# empty-battery cases need, for example a token but no TON for fees.
QA_WALLET_C_MNEMONIC=
QA_WALLET_C_TON_ADDRESS=
# Password set on every QA wallet during import. Optional: when empty, the first import makes a
# random one and keeps it in qa/.auth/password next to the saved profiles.
QA_WALLET_PASSWORD=

# Money guard. Monthly outflow caps per asset in display units; an asset without a cap cannot be spent.
# Transfers between A and B (and to self) do not count, only fees leave the pair.
QA_MONTHLY_CAPS=TON:5,USDT:10
# Preflight blocks money cases when a wallet holds less TON than this.
QA_MIN_TON_BALANCE=1

# App under test. Default: the PR's Cloudflare preview URL, passed by the verify workflow.
QA_BASE_URL=
# Desktop app under test: a packaged .app bundle, for example
# apps/desktop/out/Keeper-darwin-arm64/Keeper.app. When set, the QA wallets open in the desktop app
# instead of QA_BASE_URL, each with its own data folder in qa/.desktop. The macOS keychain is shared
# with installed copies, so desktop specs never remove a wallet or log out.
QA_DESKTOP_APP=
